# syntax=docker/dockerfile:1
FROM python:3.11 AS backend-base

LABEL org.opencontainers.image.source=https://github.com/cschlaffner/PROTzilla

RUN useradd -ms /bin/bash prot

# protein_sequencing is deliberately not pulled from GitHub here, it is installed
# editable from the local ptm-visualization checkout further down.
RUN --mount=type=bind,source=requirements.txt,target=requirements.txt \
    --mount=type=cache,target=/root/.cache/pip \
    pip install -U pip \
    && grep -v "ptm-visualization" requirements.txt > /tmp/requirements-no-ptm.txt \
    && pip install -r /tmp/requirements-no-ptm.txt

# "ptmvis" is the additional build context declared in compose.yml, it points at the
# local ptm-visualization checkout. compose.yml bind-mounts the same directory over
# this path at runtime, so edits to protein_sequencing take effect without a rebuild.
RUN install -d -o prot -g prot /home/prot/zilla
COPY --chown=prot --from=ptmvis . /home/prot/zilla/ptm-visualization
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install -e /home/prot/zilla/ptm-visualization


USER prot
WORKDIR /home/prot/zilla

RUN mkdir -p backend/user_data

RUN --mount=type=bind,source=install_scripts/database_download.py,target=install_scripts/database_download.py \
    --mount=type=bind,source=backend/protzilla/constants/paths.py,target=backend/protzilla/constants/paths.py \
    python install_scripts/database_download.py

ENV DEBUGMODE=1
CMD ["bash", "-c", "(until echo > /dev/tcp/127.0.0.1/8000 2>/dev/null; do sleep 1; done; exec python mcp-server/server.py --http) & exec python -Xfrozen_modules=off -m debugpy --listen 0.0.0.0:5678 backend/manage.py runserver 0.0.0.0:8000"]
